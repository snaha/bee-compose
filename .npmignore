# package.json `files` is the source of truth for what gets shipped — this file
# only exists to keep stray dotfiles out of the tarball if `files` is ever loosened.
# Nothing under blockchain/deploy/ or blockchain/bake/ ships: re-baking the chain
# needs a git checkout (submodules) and internet, and consumers get the committed
# snapshot instead.
src/
tsconfig.json
.gitignore
.gitmodules
.git/
.claude/
node_modules/
*.tgz
.DS_Store
*.log
blockchain/deploy/
blockchain/bake/
