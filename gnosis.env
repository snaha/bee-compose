# Gnosis chain profile for bee-compose.
#
#   docker compose --env-file gnosis.env up -d
#   node bin/bee-compose.js start --chain gnosis --full 4
#
# Boots the cluster on a snapshot of Gnosis mainnet instead of contracts
# deployed from source, so the REAL PostageStamp, BZZ token and SushiSwap pools
# are all present — offline. A postage batch bought the way the product buys it
# (swap xDAI for BZZ, then createBatch) is then one these nodes actually
# recognise, which the local profile cannot offer.
CHAIN_PROFILE=gnosis
CHAIN_ID=100

# Gnosis mainnet deployments (docs.ethswarm.org/docs/references/smart-contracts).
BEE_POSTAGE_STAMP_ADDRESS=0x45a1502382541Cd610CC9068e88727426b696293
BEE_PRICE_ORACLE_ADDRESS=0x47EeF336e7fE5bED98499A4696bce8f28c1B0a8b
BEE_STAKING_ADDRESS=0xda2a16EE889E7F04980A8d597b48c8D51B9518F4
BEE_REDISTRIBUTION_ADDRESS=0x5069cdfB3D9E56d23B1cAeE83CE6109A7E4fd62d

# The snapshot has no history before the block it was taken at, and batches
# created after it are the ones that matter. Scanning from 1 would crawl.
BEE_POSTAGE_STAMP_START_BLOCK=47504058

# A chequebook needs xBZZ and a factory deployment; uploading with your own
# stamps needs neither.
BEE_SWAP_ENABLE=false

# The p2p network id is the swarm's identity, unrelated to the chain id — keep
# the cluster private even though it follows Gnosis.
BEE_NETWORK_ID=4020
